{
  "type": "function",
  "function": {
    "name": "admin_search_orders",
    "description": "Admin-only search across orders belonging to any buyer.",
    "parameters": {
      "type": "object",
      "properties": {
        "order_id": {"type": "string", "maxLength": 100},
        "buyer_id": {"type": "string", "maxLength": 100},
        "buyer_name": {"type": "string", "maxLength": 200},
        "date_from": {"type": "string", "description": "Inclusive start date YYYY-MM-DD.", "maxLength": 10},
        "date_to": {"type": "string", "description": "Inclusive end date YYYY-MM-DD.", "maxLength": 10},
        "order_status": {"type": "string", "enum": ["Pending Confirmation", "Confirmed", "Allocated", "Picked", "Packed", "Shipped", "Delivered", "Cancelled", "Returned"]},
        "payment_status": {"type": "string", "enum": ["Paid", "Pending", "Voided", "Refunded", "Partially Refunded"]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "offset": {"type": "integer", "minimum": 0}
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
